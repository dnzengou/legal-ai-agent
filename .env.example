ANTHROPIC_API_KEY=sk-ant-...
PORT=8000
LOG_LEVEL=INFO
# Comma-separated allowlist of client API keys for /review and /review-pdf.
# Leave empty to disable auth (dev only).
API_KEYS=
# Rate limit: sustained requests/min and burst capacity, per client IP.
# Set RATE_LIMIT_PER_MIN=0 to disable. Defaults: 30/min, 60 burst.
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=60
# Trust X-Forwarded-For first hop when keying the limiter. Enable behind a proxy (Fly.io).
TRUST_PROXY_HEADERS=false
# Comma-separated CORS allowed origins. Empty disables CORS.
CORS_ORIGINS=
